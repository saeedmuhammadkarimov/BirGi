# Binance TESTNET keys (https://testnet.binance.vision/) — NEVER put mainnet keys here.
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which pairs to trade — comma-separated. Legacy SYMBOL is honored if SYMBOLS is empty.
SYMBOLS=BTCUSDT,ETHUSDT

# Loop cadence (minutes between decisions)
INTERVAL_MINUTES=15

# Max size of a single position, in USDT
MAX_POSITION_USDT=200

# Only act on Claude decisions with confidence >= this (0.0-1.0)
MIN_CONFIDENCE=0.7

# Hard rate limit on trades per hour
MAX_TRADES_PER_HOUR=4

# If true, analyze and log but do NOT place orders
DRY_RUN=false

# Claude model — sonnet-5 is a good balance for this task
CLAUDE_MODEL=claude-sonnet-5

# News signal — pulled from free CoinDesk + Cointelegraph RSS feeds (no key needed).
# Set to false to skip news entirely.
NEWS_ENABLED=true

# How many past decisions Claude sees (memory). 0 disables memory.
MEMORY_DEPTH=10

# Risk management
# ATR-based SL/TP (preferred) — closes at N × 15m ATR captured at entry.
# Adapts to per-symbol volatility. 0 disables that leg.
STOP_LOSS_ATR=2.0
TAKE_PROFIT_ATR=4.0
# Fixed-% SL/TP — fallback if ATR isn't recorded (older positions) or as safety net.
STOP_LOSS_PCT=3.0
TAKE_PROFIT_PCT=6.0
# Trailing stop — closes when price drops N% from peak since entry. 0 disables.
TRAILING_STOP_PCT=0

# Telegram notifications (optional). Leave blank to disable.
# See notifier.py header for how to obtain both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
