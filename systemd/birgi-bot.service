[Unit]
Description=BirGi Telegram Bot (MyOrg INN lookup)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=birgi
WorkingDirectory=/opt/birgi-bot
EnvironmentFile=/opt/birgi-bot/.env
ExecStart=/opt/birgi-bot/venv/bin/python /opt/birgi-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
